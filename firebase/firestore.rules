rules_version = '2';

// Reglas de la comunidad de Memomancer.
// - Cualquiera puede leer los mazos públicos (no hace falta sesión).
// - Publicar requiere sesión (anónima vale); el mazo queda a nombre de esa sesión.
// - Solo el dueño puede actualizar o retirar su mazo.
// - Las denuncias solo se pueden crear; se revisan desde la consola de Firebase.
// - La copia en la nube de cada usuario (users/{uid}/sync) solo la lee y escribe su dueño,
//   y solo con sesión de Google (no anónima).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validDeck(d) {
      return d.keys().hasOnly(['title', 'description', 'authorName', 'ownerUid', 'cards', 'cardCount',
                               'sectionNames', 'appVersion', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'description', 'authorName', 'ownerUid', 'cards', 'cardCount',
                            'sectionNames', 'appVersion', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 40
        && d.cards is list && d.cards.size() > 0 && d.cards.size() <= 2000
        && d.cardCount is int && d.cardCount == d.cards.size()
        && d.sectionNames is list && d.sectionNames.size() <= 50
        && d.appVersion is string && d.appVersion.size() <= 20
        && d.updatedAt == request.time;
    }

    match /decks/{deckId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validDeck(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validDeck(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function googleOwner(uid) {
      return signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Copia en la nube: meta (resumen) + c0…c9 (datos comprimidos, ~900 KB cada uno).
    match /users/{uid}/sync/{doc} {
      allow read, delete: if googleOwner(uid);
      allow create, update: if googleOwner(uid) && (
        (doc == 'meta'
          && request.resource.data.keys().hasOnly(['chunks', 'size', 'device', 'appVersion', 'updatedAt'])
          && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 10
          && request.resource.data.size is int
          && request.resource.data.device is string && request.resource.data.device.size() <= 40
          && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
          && request.resource.data.updatedAt == request.time)
        || (doc.matches('c[0-9]')
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 1000000)
      );
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['deckId', 'reason', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.deckId is string && request.resource.data.deckId.size() <= 40
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
