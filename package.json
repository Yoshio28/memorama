{
  "name": "memora",
  "version": "1.0.3",
  "description": "Tarjetas de estudio con repetición espaciada, secciones y modos de estudio personalizables",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win dir && node scripts/win-resources.mjs && makensis -V2 -DVERSION=$npm_package_version build/installer.nsi && node scripts/win-zip.mjs"
  },
  "author": "Memora",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "app.memora.flashcards",
    "productName": "Memora",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
