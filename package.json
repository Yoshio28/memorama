{
  "name": "memora",
  "version": "1.4.1",
  "description": "Tarjetas de estudio con repetición espaciada, secciones y modos de estudio personalizables",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win dir && node scripts/win-resources.mjs && makensis -V2 -DVERSION=$npm_package_version build/installer.nsi && node scripts/win-zip.mjs",
    "test:rules": "cd firebase && firebase emulators:exec --only auth,firestore --project demo-memora \"node test-rules.mjs\"",
    "build:mobile": "node scripts/build-mobile.mjs && npx cap sync android"
  },
  "author": "Memomancer",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "app.memora.flashcards",
    "productName": "Memomancer",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "community.js",
      "google-auth.js",
      "firebase-config.json",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
